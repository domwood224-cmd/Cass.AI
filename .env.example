# ═══════════════════════════════════════════════════════════════
# Cassidey Environment Variables
# ═══════════════════════════════════════════════════════════════
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# .env.local is gitignored and will not be committed.
#
# NOTE: Only variables prefixed with VITE_ are exposed to the
# client-side app (Vite enforces this for security).
# ═══════════════════════════════════════════════════════════════

# GEMINI_API_KEY (optional)
# Get a free API key from: https://aistudio.google.com/app/apikey
# Required only if you want cloud-powered AI responses.
# Without it, Cassidey uses her local learning engine only.
# You can also configure this at runtime via the Setup tab in the app.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GITHUB_TOKEN (required for in-app updates)
# Personal Access Token to authenticate GitHub API requests for the
# update checker and APK downloads. Required because the account is
# not visible to unauthenticated API calls.
#
# Generate at: https://github.com/settings/tokens
#   Click "Generate new token (classic)", scope: check "public_repo"
#
# IMPORTANT: Only set this in your local .env file (which is gitignored).
# Never commit the real token to the repository.
VITE_GITHUB_TOKEN=""

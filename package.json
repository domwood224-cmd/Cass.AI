{
  "name": "cassidey",
  "private": true,
  "version": "2.0.4",
  "type": "module",
  "description": "Cassidey AI Assistant — A React + Capacitor hybrid app with Gemini AI integration, skill tree system, and D3.js knowledge graph visualization",

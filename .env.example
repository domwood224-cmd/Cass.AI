# ═══════════════════════════════════════════════════════════════
# Cassidey Environment Variables
# ═══════════════════════════════════════════════════════════════
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# .env.local is gitignored and will not be committed.
#
# NOTE: Only variables prefixed with VITE_ are exposed to the
# client-side app (Vite enforces this for security).
# ═══════════════════════════════════════════════════════════════

# GEMINI_API_KEY (optional)
# Get a free API key from: https://aistudio.google.com/app/apikey
# Required only if you want cloud-powered AI responses.
# Without it, Cassidey uses her local learning engine only.
# You can also configure this at runtime via the Setup tab in the app.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"
